@model IEnumerable<OnlineJobAssignment.Models.Notification>

@{
    ViewData["Title"] = "My Notifications";
}

<h2>My Notifications</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">You have no notifications.</div>
}
else
{
    <div class="list-group">
        @foreach (var notification in Model)
        {
            <div class="list-group-item list-group-item-action @(notification.IsRead ? "" : "list-group-item-warning")">
                <div class="d-flex w-100 justify-content-between">
                    <h5 class="mb-1">@notification.Title</h5>
                    <small>@notification.CreatedAt.ToLocalTime().ToString("g")</small>
                </div>
                <p class="mb-1">@notification.Message</p>
                
                @if (!notification.IsRead)
                {
                    <form asp-action="MarkAsRead" asp-route-id="@notification.Id" method="post" class="mt-2">
                        <button type="submit" class="btn btn-sm btn-outline-primary">Mark as Read</button>
                    </form>
                }
            </div>
        }
    </div>
}
