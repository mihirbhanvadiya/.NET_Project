@model JobSequenceApp.Models.Job
@{ ViewData["Title"] = "Job Details"; }

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white">
                    <h4 class="mb-0">Job Details</h4>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Name)</dt>
                        <dd class="col-sm-8 fw-bold">@Html.DisplayFor(model => model.Name)</dd>
                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Deadline)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.Deadline)</dd>
                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Profit)</dt>
                        <dd class="col-sm-8 text-success">₹@Html.DisplayFor(model => model.Profit)</dd>
                    </dl>
                </div>
                <div class="card-footer d-flex justify-content-between bg-light">
                    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning">Edit</a>
                </div>
            </div>
        </div>
    </div>
</div>
