@model JobSequenceApp.Models.Job
@{ ViewData["Title"] = "Delete Job"; }

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="alert alert-danger shadow-sm">
                <h4 class="alert-heading"><i class="bi bi-exclamation-triangle"></i> Are you sure you want to delete this job?</h4>
                <p>This action cannot be undone.</p>
                <hr>
                <dl class="row mb-0">
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Name)</dt>
                    <dd class="col-sm-8 fw-bold">@Html.DisplayFor(model => model.Name)</dd>
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Deadline)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Deadline)</dd>
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Profit)</dt>
                    <dd class="col-sm-8 text-success">₹@Html.DisplayFor(model => model.Profit)</dd>
                </dl>
                <form asp-action="Delete" class="mt-4 d-flex justify-content-between">
                    <input type="hidden" asp-for="Id" />
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    <input type="submit" value="Delete Job" class="btn btn-danger" />
                </form>
            </div>
        </div>
    </div>
</div>
