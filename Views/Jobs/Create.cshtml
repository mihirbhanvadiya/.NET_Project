@model JobSequenceApp.Models.Job
@{ ViewData["Title"] = "Create Job"; }

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Create New Job</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-bold"></label>
                            <input asp-for="Name" class="form-control" placeholder="e.g. Job1, TaskA" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Deadline" class="form-label fw-bold"></label>
                            <input asp-for="Deadline" class="form-control" type="number" min="1" />
                            <span asp-validation-for="Deadline" class="text-danger"></span>
                        </div>
                        <div class="mb-4">
                            <label asp-for="Profit" class="form-label fw-bold"></label>
                            <input asp-for="Profit" class="form-control" type="number" step="0.01" min="0" />
                            <span asp-validation-for="Profit" class="text-danger"></span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                            <input type="submit" value="Create Job" class="btn btn-primary" />
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
