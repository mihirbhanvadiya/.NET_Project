@model IEnumerable<OnlineJobAssignment.Models.JobApplication>

@{
    ViewData["Title"] = "My Applications";
}

<h2>My Applications</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<table class="table table-striped table-bordered mt-3">
    <thead>
        <tr>
            <th>Job Title</th>
            <th>Application Date</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Job?.Title</td>
                <td>@item.ApplicationDate.ToShortDateString()</td>
                <td>
                    @{
                        var badgeClass = item.Status switch
                        {
                            OnlineJobAssignment.Models.Enums.ApplicationStatus.Pending => "bg-warning text-dark",
                            OnlineJobAssignment.Models.Enums.ApplicationStatus.Accepted => "bg-success",
                            OnlineJobAssignment.Models.Enums.ApplicationStatus.Rejected => "bg-danger",
                            OnlineJobAssignment.Models.Enums.ApplicationStatus.Withdrawn => "bg-secondary",
                            _ => "bg-primary"
                        };
                    }
                    <span class="badge @badgeClass">@item.Status</span>
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">View Details</a>
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr>
                <td colspan="4" class="text-center">You have not applied for any jobs yet.</td>
            </tr>
        }
    </tbody>
</table>
