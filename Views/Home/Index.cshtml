@{
    ViewData["Title"] = "Home Page";
}
<div class="container py-4">
    <div class="p-5 mb-4 bg-light rounded-3 shadow-sm border">
        <div class="container-fluid py-2 text-center">
            <h1 class="display-5 fw-bold text-primary"><i class="bi bi-cpu"></i> Job Sequencing with Deadlines</h1>
            <p class="col-md-10 mx-auto fs-5 mt-3">
                Welcome to JobSequenceApp, a powerful tool designed to solve the classic greedy algorithm problem: <strong>Job Sequencing with Deadlines</strong>.
                Maximize your total profit by scheduling tasks efficiently within their specified deadlines!
            </p>
            <div class="mt-4">
                @if (User.Identity.IsAuthenticated)
                {
                    <a asp-controller="Jobs" asp-action="Index" class="btn btn-primary btn-lg px-4 me-md-2">Manage Jobs</a>
                    <a asp-controller="Jobs" asp-action="Sequence" class="btn btn-outline-success btn-lg px-4">Run Algorithm</a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg px-4 me-md-2">Login to Start</a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-outline-secondary btn-lg px-4">Register</a>
                }
            </div>
        </div>
    </div>

    <div class="row align-items-md-stretch mt-5">
        <div class="col-md-4 mb-3">
            <div class="h-100 p-4 text-bg-dark rounded-3 shadow-sm">
                <h2><i class="bi bi-1-circle"></i> Create Jobs</h2>
                <p>Define available jobs by specifying a unique Job ID, a strict Deadline (time slot), and the Profit earned if completed on time.</p>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="h-100 p-4 bg-light border rounded-3 shadow-sm">
                <h2><i class="bi bi-2-circle"></i> Run Algorithm</h2>
                <p>Execute the Greedy Algorithm to sort jobs by descending profit and assign them to the latest possible available time slots.</p>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="h-100 p-4 bg-primary text-white border rounded-3 shadow-sm">
                <h2><i class="bi bi-3-circle"></i> View Results</h2>
                <p>Analyze the final scheduled sequence. See which jobs were selected, their scheduled slots, and the maximum total profit achieved.</p>
            </div>
        </div>
    </div>
</div>
