@model OnlineJobAssignment.ViewModels.MessageConversationViewModel

@{
    ViewData["Title"] = "Messages: " + Model.Job.Title;
}

<div class="container">
    <h2>Conversation for "@Model.Job.Title"</h2>
    <p class="text-muted">Chatting with @Model.OtherUserName</p>

    <div class="mb-3">
        <a asp-controller="Job" asp-action="Details" asp-route-id="@Model.Job.Id" class="btn btn-secondary btn-sm">Back to Job</a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="card mb-3">
        <div class="card-body" style="height: 400px; overflow-y: auto;" id="message-container">
            @if (!Model.Messages.Any())
            {
                <p class="text-center text-muted">No messages yet. Send a message to start the conversation.</p>
            }
            else
            {
                foreach (var msg in Model.Messages)
                {
                    bool isMine = msg.SenderId == Model.CurrentUserId;
                    <div class="d-flex w-100 justify-content-@(isMine ? "end" : "start") mb-2">
                        <div class="card @(isMine ? "bg-primary text-white" : "bg-light")" style="max-width: 75%;">
                            <div class="card-body p-2">
                                <p class="mb-1">@msg.Content</p>
                                <small class="@(isMine ? "text-light" : "text-muted")" style="font-size: 0.75em;">
                                    @msg.SentAt.ToLocalTime().ToString("g")
                                </small>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <form asp-action="Send" method="post">
        <input type="hidden" name="jobId" value="@Model.Job.Id" />
        <div class="input-group">
            <input type="text" asp-for="NewMessageContent" class="form-control" placeholder="Type your message here..." required maxlength="1000" />
            <button class="btn btn-primary" type="submit">Send</button>
        </div>
        <span asp-validation-for="NewMessageContent" class="text-danger"></span>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Scroll to the bottom of the message container on load
        var messageContainer = document.getElementById('message-container');
        messageContainer.scrollTop = messageContainer.scrollHeight;
    </script>
}
